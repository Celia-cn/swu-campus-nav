<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:extractNativeLibs="true"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gps"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <meta-data
            android:name="com.amap.api.v2.apikey"
            android:value="@string/amap_api_key" />

        <!-- 高德定位 SDK 服务；类在 AAR 中，IDE 可能报红，可忽略 -->
        <service
            android:name="com.amap.api.location.APSService"
            android:exported="false"
            tools:ignore="MissingClass,Instantiatable" />

        <activity
            android:name=".ui.AdminActivity"
            android:exported="false"
            android:theme="@style/Theme.Gps" />

        <activity
            android:name=".ui.MapActivity"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Gps" />

        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Gps.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.Gps.Login" />

        <activity
            android:name=".ui.RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.Gps.Login" />

        <activity
            android:name=".ui.ForgotPasswordActivity"
            android:exported="false"
            android:theme="@style/Theme.Gps.Login" />

        <activity
            android:name=".ui.ProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.Gps" />

        <activity
            android:name=".ui.AiChatActivity"
            android:exported="false"
            android:theme="@style/Theme.Gps"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.SpotsIntroActivity"
            android:exported="false"
            android:theme="@style/Theme.Gps" />

        <activity
            android:name=".ui.SpotDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Gps" />

        <activity
            android:name=".ui.TriggerHistoryActivity"
            android:exported="false"
            android:label="触发历史"
            android:theme="@style/Theme.Gps" />

        <activity
            android:name=".ui.ShareHubActivity"
            android:exported="false"
            android:theme="@style/Theme.Gps" />

        <activity
            android:name=".ui.ShareCreateActivity"
            android:exported="false"
            android:theme="@style/Theme.Gps" />

        <activity
            android:name=".ui.SharePostDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Gps" />

        <activity
            android:name=".ui.ShareImageViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.Gps" />

        <activity
            android:name=".ui.MyShareActivity"
            android:exported="false"
            android:theme="@style/Theme.Gps" />
    </application>

</manifest>
